# HL Intel Telegram sender config
#
# Use a bot that is an admin/poster in both HL Intel channels.
# Do not commit real tokens.

export HL_INTEL_TELEGRAM_BOT_TOKEN="123456:replace_me"

# Public Free channel can usually use the handle if the bot is an admin.
export HL_INTEL_FREE_CHAT_ID="@HLIntel"

# Pro channel can use handle only if it has a public username visible to the bot.
# For private channels, use the numeric channel id, usually shaped like -1001234567890.
export HL_INTEL_PRO_CHAT_ID="@HLIntelPro"
